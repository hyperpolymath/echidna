source = "mathcomp"
theorem = "zagierK"
id = 200101
file = "examples/zagier.v"
goal = "x y z : 0 < x -> 0 < z -> \n  let zagier t :=\n    let: (x, y, z) := t in\n    if x < y - z then (x + z.*2, z, y - z - x)\n    else if x < y.*2 then (y.*2 - x, y, x + z - y)\n    else (x - y.*2, x + z - y, y) in\n  zagier (zagier (x, y, z)) = (x, y, z)"
context = []
proof_steps = 2

