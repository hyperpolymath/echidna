# TLS-terminating reverse proxy for the public ECHIDNA API.
# Runs in the localhost/caddy-rl:2 image (see Containerfile.caddy);
# the rate_limit directive is provided by mholt/caddy-ratelimit.

{
	email j.d.a.jewell@open.ac.uk
	order rate_limit before reverse_proxy
}

api.nesy-prover.dev {
	encode zstd gzip

	# The API executes prover input; cap request size and per-client
	# rate before anything reaches it.
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# CONTAINMENT STOPGAP (owner ruling 2026-11-05). The API has no
	# authentication yet and its execution routes spawn prover binaries
	# on caller input. Until bearer auth lands on every execution route,
	# only these two read-only GET routes are forwarded. Everything else,
	# including /api/prove, /api/verify*, /api/session/* and
	# /api/agent/*, is refused here and never reaches the container.
	# Remove this matcher only in the change that enables auth.
	@public {
		method GET HEAD
		path /api/health /api/provers
	}

	# `route` keeps the written order. The rate limiter must run first: at
	# site level Caddy would sort it after the terminal `handle` blocks
	# below, and it would then never run.
	route {
		rate_limit {
			zone api {
				key {remote_host}
				events 30
				window 1m
			}
		}

		handle @public {
			# `echidna` resolves on the shared podman network (echidna.network);
			# the API container publishes no host port.
			reverse_proxy echidna:8081 {
				transport http {
					response_header_timeout 120s
				}
			}
		}

		handle {
			respond "Prover execution is disabled on this host until authentication is enabled." 403
		}
	}
}
